{
  "name": "high5",
  "version": "1.0.0",
  "description": "High5 Task Management System with Next.js",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma db push --skip-generate --accept-data-loss && next start -p ${PORT:-3000}",
    "lint": "next lint",
    "db:setup": "prisma db push --skip-generate && npm run db:seed",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^5.15.20",
    "@mui/material": "^5.15.20",
    "@prisma/client": "5.21.1",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.1",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "class-validator": "^0.14.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.469.0",
    "next": "^15.1.3",
    "next-auth": "^4.24.11",
    "otpauth": "^9.5.1",
    "papaparse": "^5.4.1",
    "prisma": "5.21.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-quill-new": "^3.8.3",
    "sanitize-html": "^2.17.5",
    "ts-node": "^10.9.2",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.7",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.1.3",
    "typescript": "^5.4.5"
  }
}
