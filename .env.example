# Database (Railway PostgreSQL — Railway에서 Postgres 플러그인 추가 시 DATABASE_URL 자동 주입)
# 로컬 개발 시에는 Railway 프로젝트의 DATABASE_URL(Public Network 값)을 복사해서 사용
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST.railway.app:5432/railway

# NextAuth
NEXTAUTH_SECRET=generate_with_openssl_rand_-base64_32
# 배포 환경에서는 Railway가 발급한 도메인으로 설정 (예: https://your-app.up.railway.app)
NEXTAUTH_URL=http://localhost:3000

# API
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# JWT
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800

# Slack Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# GitHub Webhook (PR 머지 시 자동 완료 처리)
GITHUB_WEBHOOK_SECRET=

# 잔디(JANDI) Webhook
JANDI_WEBHOOK_URL=https://wh.jandi.com/connect-api/webhook/xxx

# 카카오톡(Kakao) Webhook (카카오 플러스친구 API)
KAKAO_WEBHOOK_URL=https://kapi.kakao.com/v2/api/talk/memo/default/send

# Kakao Access Token (카카오 개발자 센터에서 발급)
KAKAO_ACCESS_TOKEN=

# Redis (Optional - for Bull queue alternative)
REDIS_URL=redis://localhost:6379

# Anthropic (Claude API — AI 캘린더 요약 등 AI 기능에 사용, 미설정 시 AI 기능은 오류 응답 반환)
ANTHROPIC_API_KEY=

# Google Calendar OAuth (실시간 캘린더 연동 — 미설정 시 연동 버튼이 "준비 중"으로 표시됨)
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 OAuth 클라이언트 ID 발급
# 승인된 리디렉션 URI: {NEXTAUTH_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 이메일 발송 (SMTP — 미설정 시 콘솔 로그로만 대체, 데모신청 확인메일/가입 환영메일 등에 사용)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=High5 <no-reply@high5.app>

# 플랫폼 관리자 알림 (데모 신청/신규 조직 가입 시 이메일로도 알림 받고 싶을 때)
PLATFORM_ADMIN_EMAIL=

# Sentry 에러 트래킹 (미설정 시 비활성화)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Google Analytics (미설정 시 스크립트 자체가 삽입되지 않음)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
