# Database (Railway PostgreSQL — Railway에서 Postgres 플러그인 추가 시 DATABASE_URL 자동 주입)
# 로컬 개발 시에는 Railway 프로젝트의 DATABASE_URL(Public Network 값)을 복사해서 사용
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST.railway.app:5432/railway

# NextAuth
NEXTAUTH_SECRET=generate_with_openssl_rand_-base64_32
# 배포 환경에서는 Railway가 발급한 도메인으로 설정 (예: https://your-app.up.railway.app)
NEXTAUTH_URL=http://localhost:3000

# API
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# JWT
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800

# Slack Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# GitHub Webhook (PR 머지 시 자동 완료 처리)
GITHUB_WEBHOOK_SECRET=

# 잔디(JANDI) Webhook
JANDI_WEBHOOK_URL=https://wh.jandi.com/connect-api/webhook/xxx

# 카카오톡(Kakao) Webhook (카카오 플러스친구 API)
KAKAO_WEBHOOK_URL=https://kapi.kakao.com/v2/api/talk/memo/default/send

# Kakao Access Token (카카오 개발자 센터에서 발급)
KAKAO_ACCESS_TOKEN=

# Redis (Optional - for Bull queue alternative)
REDIS_URL=redis://localhost:6379
