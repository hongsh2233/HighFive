# Database
DATABASE_URL=postgresql://user:password@localhost:5432/tms_db

# NextAuth
NEXTAUTH_SECRET=your_super_secret_key_here_min_32_characters
NEXTAUTH_URL=http://localhost:3000

# API
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# JWT
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800

# Slack Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# 잔디(JANDI) Webhook
JANDI_WEBHOOK_URL=https://wh.jandi.com/connect-api/webhook/xxx

# 카카오톡(Kakao) Webhook (카카오 플러스친구 API)
KAKAO_WEBHOOK_URL=https://kapi.kakao.com/v2/api/talk/memo/default/send

# Kakao Access Token (카카오 개발자 센터에서 발급)
KAKAO_ACCESS_TOKEN=

# Redis (Optional - for Bull queue alternative)
REDIS_URL=redis://localhost:6379
