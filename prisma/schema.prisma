// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ──────────────────────────────────────────────
// 멀티테넌시 루트 모델
// ──────────────────────────────────────────────

model Organization {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique  // URL 식별자 (예: acme, my-company)
  plan      String   @default("FREE")  // FREE, PRO, ENTERPRISE
  isActive  Boolean  @default(true)
  bizNo     String?
  phone     String?
  ceoName   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  projects       Project[]
  tasks          Task[]
  infoItems      InfoItem[]
  announcements  Announcement[]
  requests       Request[]
  stickyNotes    StickyNote[]
  userPages      UserPage[]
  userNotifications UserNotification[]
  integrations   Integration[]
  templates      Template[]
  inviteTokens   InviteToken[]
  inquiries      Inquiry[]
  meetingNotes   MeetingNote[]

  @@map("organizations")
}

model InviteToken {
  id             Int       @id @default(autoincrement())
  token          String    @unique
  email          String
  organizationId Int
  role           String    @default("WORKER")
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invite_tokens")
}

// ──────────────────────────────────────────────
// 사용자
// ──────────────────────────────────────────────

model User {
  id             Int       @id @default(autoincrement())
  organizationId Int?
  email          String    @unique
  name           String
  role           String    @default("WORKER") // ADMIN, LEADER, WORKER
  passwordHash   String
  isActive       Boolean   @default(true)
  leaveDate      DateTime?
  affiliation    String?   // 정규 | 프리
  managerId      Int?      // 결재 라인상의 담당 리더(상급자)
  totpSecret     String?
  totpEnabled    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  lastLoginAt    DateTime?

  // Relations
  organization      Organization?   @relation(fields: [organizationId], references: [id])
  registeredTasks   Task[]          @relation("registrant")
  workerTasks       Task[]          @relation("worker")
  timeLogs          TimeLog[]
  infoItems         InfoItem[]
  projectMembers    ProjectMember[]
  createdProjects   Project[]       @relation("projectCreator")
  taskHistories     TaskHistory[]
  userNotifications UserNotification[]
  manager           User?           @relation("userManager", fields: [managerId], references: [id])
  subordinates      User[]          @relation("userManager")
  announcements     Announcement[]  @relation("announcementAuthor")
  requestsMade      Request[]       @relation("requestRequester")
  requestsToApprove Request[]       @relation("requestApprover")
  wikiPages         WikiPage[]      @relation("wikiAuthor")
  stickyNotes       StickyNote[]
  userPages         UserPage[]
  taskComments      TaskComment[]
  userSessions      UserSession[]
  meetingNotesAuthored MeetingNote[]        @relation("meetingAuthor")
  meetingActionItems   MeetingActionItem[]  @relation("meetingActionAssignee")

  @@index([organizationId])
  @@map("users")
}

// ──────────────────────────────────────────────
// 업무
// ──────────────────────────────────────────────

model Task {
  id                 Int       @id @default(autoincrement())
  organizationId     Int?
  rmsNo              String?
  title              String
  registrantId       Int       @map("plannerId")
  workerId           Int
  status             String    @default("ASSIGNED")
  targetDate         DateTime?
  isFreeze           Boolean   @default(false)
  templateId         Int?
  notes              String?
  externalLink       String?
  projectId          Int?
  labels             String?
  isGroup            Boolean   @default(false)
  timeCounterEnabled Boolean   @default(true)
  parentTaskId       Int?
  sourceType         String    @default("DIRECT") // DIRECT / INQUIRY / MEETING
  sourceId           Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  organization  Organization? @relation(fields: [organizationId], references: [id])
  registrant    User          @relation("registrant", fields: [registrantId], references: [id])
  worker        User          @relation("worker", fields: [workerId], references: [id])
  project       Project?      @relation(fields: [projectId], references: [id])
  timeLogs      TimeLog[]
  histories     TaskHistory[]
  parentTask    Task?         @relation("subTasks", fields: [parentTaskId], references: [id])
  subTasks      Task[]        @relation("subTasks")
  fieldValues   TaskFieldValue[]
  comments      TaskComment[]

  @@index([organizationId, workerId, status])
  @@index([organizationId, targetDate])
  @@index([rmsNo])
  @@index([parentTaskId])
  @@map("tasks")
}

model TimeLog {
  id            Int      @id @default(autoincrement())
  taskId        Int
  workerId      Int
  startTime     DateTime
  endTime       DateTime?
  durationHours Float?
  adjustedHours Float    @default(0)
  finalHours    Float?
  createdAt     DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  worker User @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([workerId])
  @@map("timelogs")
}

model Template {
  id               Int      @id @default(autoincrement())
  organizationId   Int?
  name             String
  defaultTitle     String
  defaultPlannerId Int?
  guideText        String?
  createdAt        DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("templates")
}

model Notification {
  id        Int      @id @default(autoincrement())
  taskId    Int
  channel   String
  message   String
  sentAt    DateTime @default(now())
  isSuccess Boolean  @default(false)

  @@index([taskId])
  @@map("notifications")
}

// ──────────────────────────────────────────────
// 프로젝트
// ──────────────────────────────────────────────

model Project {
  id                 Int      @id @default(autoincrement())
  organizationId     Int?
  name               String
  status             String   @default("ACTIVE")
  createdBy          Int?
  projectManagerName String?
  projectLeadName    String?

  organization Organization?   @relation(fields: [organizationId], references: [id])
  creator      User?           @relation("projectCreator", fields: [createdBy], references: [id])
  members      ProjectMember[]
  tasks        Task[]
  wikiPages    WikiPage[]
  meetingNotes MeetingNote[]
  statuses     ProjectStatus[]
  fields       ProjectField[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([organizationId])
  @@map("projects")
}

model ProjectMember {
  projectId Int
  userId    Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@id([projectId, userId])
  @@map("project_members")
}

// ──────────────────────────────────────────────
// 정보 / 공지 / 신청
// ──────────────────────────────────────────────

model InfoItem {
  id             Int      @id @default(autoincrement())
  organizationId Int?
  question       String
  answer         String   @db.Text
  order          Int      @default(0)
  isActive       Boolean  @default(true)
  createdBy      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  author       User          @relation(fields: [createdBy], references: [id])

  @@index([organizationId, order])
  @@map("info_items")
}

model TaskHistory {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  action    String
  detail    String?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@map("task_histories")
}

model UserNotification {
  id             Int      @id @default(autoincrement())
  organizationId Int?
  userId         Int
  taskId         Int?
  type           String
  message        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([organizationId])
  @@map("user_notifications")
}

model Announcement {
  id             Int      @id @default(autoincrement())
  organizationId Int?
  content        String   @db.Text
  authorId       Int
  isActive       Boolean  @default(true)
  requestId      Int?     @unique
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  author       User          @relation("announcementAuthor", fields: [authorId], references: [id])
  request      Request?      @relation(fields: [requestId], references: [id])

  @@index([organizationId, isActive])
  @@map("announcements")
}

model Request {
  id             Int       @id @default(autoincrement())
  organizationId Int?
  type           String
  title          String
  content        String?   @db.Text
  startDate      DateTime?
  endDate        DateTime?
  isAnnouncement Boolean   @default(false)
  status         String    @default("PENDING")
  requesterId    Int
  approverId     Int?
  rejectReason   String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  requester    User          @relation("requestRequester", fields: [requesterId], references: [id])
  approver     User?         @relation("requestApprover", fields: [approverId], references: [id])
  announcement Announcement?

  @@index([organizationId, requesterId])
  @@index([approverId, status])
  @@index([type, status, startDate])
  @@map("requests")
}

// ──────────────────────────────────────────────
// 위키
// ──────────────────────────────────────────────

model WikiPage {
  id        Int      @id @default(autoincrement())
  projectId Int
  title     String
  content   String   @db.Text
  authorId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation("wikiAuthor", fields: [authorId], references: [id])

  @@index([projectId])
  @@map("wiki_pages")
}

// ──────────────────────────────────────────────
// 업무 접수 (홈페이지 문의 / 미팅 액션아이템)
// ──────────────────────────────────────────────

model Inquiry {
  id              Int       @id @default(autoincrement())
  organizationId  Int
  name            String
  contact         String
  type            String
  content         String    @db.Text
  status          String    @default("NEW") // NEW / IN_REVIEW / CONVERTED / CLOSED
  closeReason     String?
  convertedTaskId Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("inquiries")
}

model MeetingNote {
  id             Int      @id @default(autoincrement())
  organizationId Int
  projectId      Int
  title          String
  meetingDate    DateTime?
  attendees      String?
  content        String   @db.Text
  authorId       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author       User                @relation("meetingAuthor", fields: [authorId], references: [id])
  actionItems  MeetingActionItem[]

  @@index([organizationId, projectId])
  @@map("meeting_notes")
}

model MeetingActionItem {
  id            Int       @id @default(autoincrement())
  meetingNoteId Int
  content       String
  assigneeId    Int?
  targetDate    DateTime?
  status        String    @default("OPEN") // OPEN / CONVERTED
  taskId        Int?
  order         Int       @default(0)

  meetingNote MeetingNote @relation(fields: [meetingNoteId], references: [id], onDelete: Cascade)
  assignee    User?       @relation("meetingActionAssignee", fields: [assigneeId], references: [id])

  @@index([meetingNoteId])
  @@map("meeting_action_items")
}

// ──────────────────────────────────────────────
// 외부 연동 (조직별)
// ──────────────────────────────────────────────

model Integration {
  id             Int      @id @default(autoincrement())
  organizationId Int?
  channel        String   // SLACK, JANDI, TEAMS, TELEGRAM, KAKAO
  webhookUrl     String?
  botToken       String?
  chatId         String?
  isEnabled      Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, channel])
  @@map("integrations")
}

// ──────────────────────────────────────────────
// 프로젝트 커스텀 상태 / 필드
// ──────────────────────────────────────────────

model ProjectStatus {
  id         Int      @id @default(autoincrement())
  projectId  Int
  code       String
  label      String
  color      String?
  order      Int      @default(0)
  isProgress Boolean  @default(false)
  isDone     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, code])
  @@index([projectId, order])
  @@map("project_statuses")
}

model ProjectField {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  type      String
  options   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values  TaskFieldValue[]

  @@unique([projectId, name])
  @@index([projectId, order])
  @@map("project_fields")
}

model TaskFieldValue {
  id      Int    @id @default(autoincrement())
  taskId  Int
  fieldId Int
  value   String?

  task  Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  field ProjectField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([taskId, fieldId])
  @@index([taskId])
  @@map("task_field_values")
}

// ──────────────────────────────────────────────
// 개인 메모 / 페이지
// ──────────────────────────────────────────────

model StickyNote {
  id             Int      @id @default(autoincrement())
  organizationId Int?
  userId         Int
  content        String   @db.Text
  color          String?
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, order])
  @@map("sticky_notes")
}

model TaskComment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  authorId  Int
  parentId  Int?
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task    Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id])
  parent  TaskComment?  @relation("replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies TaskComment[] @relation("replies")

  @@index([taskId])
  @@index([parentId])
  @@map("task_comments")
}

model UserPage {
  id             Int      @id @default(autoincrement())
  organizationId Int?
  userId         Int
  title          String
  content        String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_pages")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       Int
  deviceName   String?
  ipAddress    String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  organizationId Int?
  userId         Int?
  userEmail      String?
  action         String
  targetType     String?
  targetId       Int?
  detail         Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model SystemConfig {
  id           Int      @id @default(1)
  planFeatures Json
  updatedAt    DateTime @updatedAt

  @@map("system_config")
}
