// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int     @id @default(autoincrement())
  email         String  @unique
  name          String
  role          String  @default("WORKER") // ADMIN, LEADER, WORKER
  passwordHash  String
  isActive      Boolean @default(true)
  leaveDate     DateTime?
  affiliation   String?  // 정규 | 프리
  managerId     Int?     // 결재 라인상의 담당 리더(상급자)
  createdAt     DateTime @default(now())
  lastLoginAt   DateTime?

  // Relations
  plannedTasks    Task[]          @relation("planner")
  workerTasks     Task[]          @relation("worker")
  timeLogs        TimeLog[]
  infoItems       InfoItem[]
  projectMembers  ProjectMember[]
  createdProjects Project[]       @relation("projectCreator")
  taskHistories   TaskHistory[]
  userNotifications UserNotification[]
  manager           User?          @relation("userManager", fields: [managerId], references: [id])
  subordinates       User[]        @relation("userManager")
  announcements      Announcement[] @relation("announcementAuthor")
  requestsMade       Request[]      @relation("requestRequester")
  requestsToApprove  Request[]      @relation("requestApprover")
  wikiPages          WikiPage[]     @relation("wikiAuthor")

  @@map("users")
}

model Task {
  id            Int     @id @default(autoincrement())
  rmsNo         String?
  title         String
  plannerId     Int
  workerId      Int
  status        String  @default("ASSIGNED") // ASSIGNED, PROGRESS, REVIEW, QA, DONE
  targetDate    DateTime?
  isFreeze      Boolean @default(false)
  templateId    Int?
  notes         String?
  externalLink  String?
  projectId     Int?
  labels        String?   // 콤마 구분 라벨 코드 ex) "URGENT,WEEKEND"
  isGroup       Boolean  @default(false) // 그룹 업무 여부 (하위 업무를 나중에 추가할 수 있는 부모 업무)
  timeCounterEnabled Boolean @default(true) // 상태 변경에 따른 자동 시간 카운트 사용 여부
  parentTaskId  Int?      // 그룹 업무의 하위 업무인 경우 부모 업무 id
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  planner       User     @relation("planner", fields: [plannerId], references: [id])
  worker        User     @relation("worker", fields: [workerId], references: [id])
  project       Project? @relation(fields: [projectId], references: [id])
  timeLogs      TimeLog[]
  histories     TaskHistory[]
  parentTask    Task?    @relation("subTasks", fields: [parentTaskId], references: [id])
  subTasks      Task[]   @relation("subTasks")

  @@index([workerId, status])
  @@index([targetDate])
  @@index([rmsNo])
  @@index([parentTaskId])
  @@map("tasks")
}

model TimeLog {
  id            Int     @id @default(autoincrement())
  taskId        Int
  workerId      Int
  startTime     DateTime
  endTime       DateTime?
  durationHours Float?
  adjustedHours Float   @default(0)
  finalHours    Float?
  createdAt     DateTime @default(now())

  // Relations
  task          Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  worker        User    @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([workerId])
  @@map("timelogs")
}

model Template {
  id                Int     @id @default(autoincrement())
  name              String
  defaultTitle      String
  defaultPlannerId  Int?
  guideText         String?
  createdAt         DateTime @default(now())

  @@map("templates")
}

model Notification {
  id        Int     @id @default(autoincrement())
  taskId    Int
  channel   String  // SLACK, JANDI, EMAIL
  message   String
  sentAt    DateTime @default(now())
  isSuccess Boolean @default(false)

  @@index([taskId])
  @@map("notifications")
}

model Project {
  id                 Int      @id @default(autoincrement())
  name               String
  status             String   @default("ACTIVE") // ACTIVE, CLOSED
  createdBy          Int?
  projectManagerName String?
  projectLeadName    String?
  creator            User?    @relation("projectCreator", fields: [createdBy], references: [id])
  members            ProjectMember[]
  tasks            Task[]
  wikiPages        WikiPage[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("projects")
}

model ProjectMember {
  projectId Int
  userId    Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@id([projectId, userId])
  @@map("project_members")
}

model InfoItem {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdBy Int
  author    User     @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@map("info_items")
}

model TaskHistory {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  action    String   // CREATED, STATUS_CHANGED, WORKER_CHANGED, TIMER_START, TIMER_STOP, NOTE_UPDATED, TRANSFERRED
  detail    String?
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@map("task_histories")
}

model UserNotification {
  id        Int      @id @default(autoincrement())
  userId    Int
  taskId    Int?
  type      String   // WORKER_ASSIGNED, REVIEW_REQUESTED, WORKER_CHANGED
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("user_notifications")
}

model Announcement {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  authorId  Int
  isActive  Boolean  @default(true)
  requestId Int?     @unique // 신청서에서 '공지로 등록'(전결)으로 자동 생성된 경우 연결
  createdAt DateTime @default(now())

  author    User     @relation("announcementAuthor", fields: [authorId], references: [id])
  request   Request? @relation(fields: [requestId], references: [id])

  @@index([isActive])
  @@map("announcements")
}

model Request {
  id             Int       @id @default(autoincrement())
  type           String    // LEAVE, SUPPLY
  title          String
  content        String?   @db.Text
  startDate      DateTime? // LEAVE 전용 (휴가 시작일)
  endDate        DateTime? // LEAVE 전용 (휴가 종료일)
  isAnnouncement Boolean   @default(false) // 체크 시 결재 없이 전결 처리 + 공지 배너 게시
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  requesterId    Int
  approverId     Int?      // 신청 시점의 담당 리더(User.managerId) 스냅샷
  rejectReason   String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  requester      User          @relation("requestRequester", fields: [requesterId], references: [id])
  approver       User?         @relation("requestApprover", fields: [approverId], references: [id])
  announcement   Announcement?

  @@index([requesterId])
  @@index([approverId, status])
  @@index([type, status, startDate])
  @@map("requests")
}

model WikiPage {
  id        Int      @id @default(autoincrement())
  projectId Int
  title     String
  content   String   @db.Text
  authorId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User     @relation("wikiAuthor", fields: [authorId], references: [id])

  @@index([projectId])
  @@map("wiki_pages")
}

model Integration {
  id         Int      @id @default(autoincrement())
  channel    String   @unique // SLACK, JANDI, TEAMS, TELEGRAM, KAKAO
  webhookUrl String?
  botToken   String?  // TELEGRAM 봇 토큰
  chatId     String?  // TELEGRAM chat id
  isEnabled  Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@map("integrations")
}
